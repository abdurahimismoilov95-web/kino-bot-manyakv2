# =============================================================================
#  MANYAK TV v2 - Environment Variables
#  .env.example -> .env kopi oling va qiymatlarni to'ldiring
# =============================================================================

# App
NODE_ENV=production
PORT=3001
APP_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=manyaktv
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=manyaktv
DATABASE_URL=postgresql://manyaktv:CHANGE_ME@localhost:5432/manyaktv

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# JWT
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_STRING_MIN_64_CHARS
JWT_EXPIRES_IN=30d

# Telegram
TELEGRAM_BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_RANDOM_STRING

# Admins
SUPER_ADMIN_ID=123456789
ADDITIONAL_ADMIN_IDS=987654321,111222333

# File Storage
UPLOADS_DIR=/var/www/uploads
HLS_OUTPUT_DIR=/var/www/hls
FILE_SIGNING_SECRET=CHANGE_ME_SIGNING_SECRET
FILE_SIGNED_URL_TTL_SECONDS=3600
NGINX_HLS_BASE_URL=https://yourdomain.com/hls
