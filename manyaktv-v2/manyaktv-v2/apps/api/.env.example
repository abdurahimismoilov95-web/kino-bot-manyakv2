# =============================================================================
#  MANYAK TV v2 — Backend Environment Variables
#  Bu faylni .env nomi bilan nusxa oling va qiymatlarni to'ldiring
# =============================================================================

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://manyaktv:changeme@localhost:5432/manyaktv
DB_POOL_MIN=5
DB_POOL_MAX=50
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Kamida 64 belgili tasodifiy satr: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_USE_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret
SUPER_ADMIN_ID=your_telegram_id_here

# ─── Admin brauzer kirish kodi ────────────────────────────────────────────────
# Kamida 16 belgi, murakkab parol! Faqat admin login sahifasida ishlatiladi.
ADMIN_BROWSER_SECRET=CHANGE_ME_AtLeast16Chars!!

# ─── File Storage ─────────────────────────────────────────────────────────────
UPLOADS_DIR=/app/uploads
HLS_OUTPUT_DIR=/app/hls-output
FILE_SIGNING_SECRET=CHANGE_ME_file_signing_secret

# ─── HLS / Streaming ──────────────────────────────────────────────────────────
NGINX_HLS_BASE_URL=http://localhost/hls
HLS_AUTH_CACHE_TTL=30

# ─── Optional: Postgres Docker vars ───────────────────────────────────────────
POSTGRES_USER=manyaktv
POSTGRES_PASSWORD=changeme
POSTGRES_DB=manyaktv
