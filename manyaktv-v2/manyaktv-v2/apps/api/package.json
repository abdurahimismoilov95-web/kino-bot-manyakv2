{
  "name": "@manyaktv/api",
  "version": "2.0.0",
  "description": "ManyakTV NestJS API Service",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:migrate": "typeorm migration:run -d src/config/datasource.ts",
    "db:migrate:revert": "typeorm migration:revert -d src/config/datasource.ts",
    "db:generate": "typeorm migration:generate -d src/config/datasource.ts",
    "db:seed": "ts-node src/database/seeds/run-seeds.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/bull": "^10.2.3",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/swagger": "^8.0.0",
    "@nestjs/throttler": "^6.2.1",
    "typeorm": "^0.3.20",
    "pg": "^8.13.1",
    "bull": "^4.16.0",
    "ioredis": "^5.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "crypto-js": "^4.2.0",
    "multer": "^2.0.0",
    "sharp": "^0.33.5",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "helmet": "^8.0.0",
    "compression": "^1.7.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "node-telegram-bot-api": "^0.66.0",
    "@nestjs-modules/ioredis": "^2.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/multer": "^1.4.12",
    "@types/passport-jwt": "^4.0.1",
    "@types/node-telegram-bot-api": "^0.64.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}